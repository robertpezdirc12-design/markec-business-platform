# ===== Baza podatkov (PostgreSQL) =====
# Neon / Supabase / lokalni Postgres
DATABASE_URL="postgresql://user:password@localhost:5432/beauty_salon"

# Prisma directUrl — ne-pooled povezava za migracije (migrate deploy).
# Vercel jo nastavi za vsak target posebej:
#   production -> Neon main, preview/development -> Neon preview.
# Za lokalni razvoj uporabi isto vrednost kot DATABASE_URL.
# OBVEZNO: brez te spremenljivke `prisma generate` pade (P1012).
DIRECT_URL="postgresql://user:password@localhost:5432/beauty_salon"

# ===== NextAuth =====
# Ustvari z: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ===== Google OAuth (prijava z Google računom, NEOBVEZNO) =====
# Client ID in Secret iz Google Auth Platform → Clients. Authorized redirect URI:
#   [VAŠ_ORIGIN]/api/auth/callback/google  (npr. http://localhost:3000/... v dev)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ===== Aplikacija =====
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# A/B feature-list (UX): "short" skrije ne-obvezno polje "posebne želje" v
# booking formi (krajša oblika → manj kognitivne obremenitve). Prazno ali
# "full" = polna oblika. Za merjenje konverzije testne vožnje nastavi prek
# okolja ob build (NEXT_PUBLIC je inline-iran ob build).
NEXT_PUBLIC_BOOKING_AB_VARIANT=""

# ===== Šifriranje skrivnosti v mirovanju (PRIPOROČENO) =====
# Ključi, ki jih salon vpiše v Nastavitve → Plačila (Stripe secret + webhook
# secret), se v bazi hranijo šifrirani (AES-256-GCM). Brez te spremenljivke
# aplikacija deluje, a skrivnosti se shranjujejo v čistini, v dnevniku pa
# opozorilo. V produkciji OBAVEZNO nastavite (>= 32 znakov, naključno):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Ključa NE spreminjajte brez ponovnega vpisa ključev v Nastavitvah — starih
# šifriranih vrednosti s tem ključem ne bo mogoče odpreti.
SECRETS_ENCRYPTION_KEY=""

# ===== Stripe (NEOBVEZNO) =====
# Priporočeno: admin vnese ključe v Nastavitve → Plačila (brez deploya).
# Ti ključi služijo le kot platformni fallback za salone brez svojih ključev.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ===== Platformne naročnine (EPIC #3 E3-4, NEOBVEZNO) =====
# Ločen Stripe račun PLATFORME (najemniki → platforma tok denarja),
# popolnoma ločen od zgornjih per-tenant ključev (najemnik → njegove stranke).
# Brez teh ključev UI pošteno prikaže "setup required" — nič ni faked.
PLATFORM_STRIPE_SECRET_KEY=""
PLATFORM_STRIPE_WEBHOOK_SECRET=""
# Recurring price ids za plačljive pakete (Stripe Dashboard → Products).
# Webhook endpoint: /api/webhooks/platform-stripe
PLATFORM_STRIPE_PRICE_PRO=""
PLATFORM_STRIPE_PRICE_SCALE=""

# ===== Operaterska konzola (EPIC #3 E3-5) =====
# E-poštni naslovi operaterjev platforme (ločeni z vejico). To je EDINI
# vir dostopa do /platform — fail-closed: prazen seznam = nihče nima dostopa.
# Najemniški lastniki (ADMIN v svoji org) NIKOLI niso operaterji po defaultu.
PLATFORM_ADMIN_EMAILS="ops@example.org"

# ===== Lastne domene (EPIC #3 E3-6, NEOBVEZNO) =====
# Ponudnik domen za povezovanje lastnih domen najemnikov (issue #3 §7).
# Vercel Domains API: token mora imeti dostop do projekta. BREZ teh ključev
# UI pošteno pokaže "ponudnik ni konfiguriran" — domena nikoli ni označena
# kot preverjena, dokler ponudnik tega NE POTRDI.
DOMAINS_VERCEL_TOKEN=""
DOMAINS_VERCEL_PROJECT_ID=""
# Neobvezno (za team račun): DOMAINS_VERCEL_TEAM_ID=""


# ============================================================
# #99 — PUSH obvestila lastniku (VAPID Web Push) + dnevni digest
# ============================================================
# Par ključev za VAPID — generiraj enkrat:
#   npx web-push generate-vapid-keys
# BREZ paru je push pošteno izklopljen (UI pokaže "ni nastavljeno"),
# dnevni digest po e-pošti pa deluje neodvisno (RESEND_API_KEY).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Predmet push pošiljatelja (mailto ali https URL).
VAPID_SUBJECT="mailto:info@markec.si"

# ============================================================
# E-POŠTA (Resend) — brez teh ključev se potrditvena/preklicna
# sporočila NE pošiljajo; v produkciji je zato prijava onemogočena
# (EMAIL_VERIFICATION_FALLBACK je v produkciji privzeto izklopljen).
# ============================================================
RESEND_API_KEY=""
# Pošiljatelj, npr. "Markec <no-reply@markec.si>". Domena mora biti
# verificirana v Resend.
RESEND_FROM_EMAIL=""

# ============================================================
# CRON / PODPISOVANJE POVEZAV
# ============================================================
# Skrivnost za /api/cron/* (Authorization: Bearer <CRON_SECRET>).
# Brez nje so cron endpointi zaprti (fail-closed).
CRON_SECRET=""
# Namenska skrivnost za podpis odjavnih povezav (marketing). Če ni
# nastavljena, se uporabi CRON_SECRET; brez obeh odjava ni mogoča.
UNSUBSCRIBE_SECRET=""

# ============================================================
# NAJEMNIŠKI PROXY PROOF (HMAC med proxyjem in aplikacijo)
# ============================================================
# Loči zaupanja vreden proxy od neposrednih klicev. Če ni nastavljena,
# se uporabi AUTH_SECRET (deluje, a ločena skrivnost je boljša praksa).
TENANT_PROXY_SECRET=""

# ============================================================
# SHRAMBA DATOTEK (R2) — neobvezno; brez tega upload pade na lokalno
# ============================================================
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_ENDPOINT=""
R2_PUBLIC_URL=""

# ============================================================
# SLIKE (Cloudinary) — neobvezno
# ============================================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ============================================================
# E-RAČUNI (eSLOG / e-invoice) — neobvezno
# ============================================================
# Ključ za šifriranje poverilnic e-računov (ločen od SECRETS_ENCRYPTION_KEY).
EINVOICE_SECRET_KEY=""
# "1" = validator namesto produkcijskega strežnika (testno okolje).
EINVOICE_VALIDATOR=""

# ============================================================
# DOMENE / PLATFORMA
# ============================================================
# Eksplicitni seznam platformnih gostiteljev (vejica), npr.
# "markec.si,www.markec.si". Prazno = zaznaj po privzetih pravilih.
PLATFORM_HOSTS=""
# Ko je nastavljeno, goli obisk /services ipd. 308 preusmeri na
# /s/<slug>/... (dedno pravilo za stare povezave). Prazno = 404.
LEGACY_DEFAULT_SLUG=""

# ============================================================
# MOBILNE APLIKACIJE (povezave v nogi / nastavitvah) — neobvezno
# ============================================================
NEXT_PUBLIC_APP_STORE_URL=""
NEXT_PUBLIC_PLAY_STORE_URL=""
