{
  "name": "markec-business-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "next dev --turbopack -p 3008",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "check:assets": "node scripts/check-third-party-assets.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:drift": "node scripts/check-preview-schema-drift.mjs",
    "mail:check": "node scripts/check-mail-setup.mjs",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:check-db": "node scripts/test-db-guard.mjs",
    "test:db:migrate": "node scripts/run-with-test-db.mjs prisma migrate deploy",
    "test:db:push": "node scripts/run-with-test-db.mjs prisma db push",
    "test:itest": "node scripts/run-with-test-db.mjs vitest run --config vitest.itest.config.ts",
    "depcruise": "depcruise src prisma scripts"
  },
