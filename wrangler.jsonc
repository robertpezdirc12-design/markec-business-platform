{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "markec-business-platform",
  "main": "worker.js",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  // The app's only system timer (/api/cron/tick) is owned by VERCEL CRON
  // (see vercel.json) — Vercel is the primary deployer. `worker.js` still
  // implements the `scheduled` handler, but it is INERT here on purpose:
  // two schedulers at 03:00 UTC would fire the reminder/marketing jobs
  // twice and risk duplicate e-mail. Re-add a "triggers" block here only
  // after removing the cron entry from vercel.json.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NODE_ENV": "production",
    "AUTH_TRUST_HOST": "true"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "markec-business-platform"
    }
  ]
}