{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "markec-business-platform",
  "main": "worker.js",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  // The app's only system timer (/api/cron/tick) is owned by VERCEL CRON
  // (see vercel.json) — Vercel is the primary deployer. `worker.js` still
  // implements the `scheduled` handler, but it is INERT here on purpose:
  // two schedulers at 03:00 UTC would fire the reminder/marketing jobs
  // twice and risk duplicate e-mail. Re-add a "triggers" block here only
  // after removing the cron entry from vercel.json.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NODE_ENV": "production",
    "AUTH_TRUST_HOST": "true",
    // src/lib/prisma.ts: na Workers rabi client NA ZAHTEVO (I/O pravilo),
    // na Vercelu en sam modulski client. Ta oznaka pove, kje smo — brez
    // nje bi Workers dobil singleton in bi spet javljal
    // "Cannot perform I/O on behalf of a different request".
    "RUNTIME": "workers"
    // P0 (audit 2026-11): EMAIL_VERIFICATION_FALLBACK je ODSTRANJEN.
    // Zastavica je v produkciji dovolila, da se potrditvena povezava (in
    // prej tudi žeton za ponastavitev gesla) vrne v HTTP odgovoru — brez
    // prijave. Posledica: prevzem kateregakoli računa, če RESEND_API_KEY na
    // Workerju ni nastavljen. Brez zastavice velja fail-closed
    // (src/lib/email/config.ts): v produkciji se povezava ne prikaže, v
    // razvoju pa se izpiše v strežniški dnevnik. Za produkcijo nastavite
    // RESEND_API_KEY; če ga namenoma nimate, uporabnike potrdite ročno.
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "markec-business-platform"
    }
  ]
}